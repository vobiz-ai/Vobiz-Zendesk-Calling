# Port the backend listens on.
PORT=8092

# ---------------------------------------------------------------------------
# Vobiz credentials (optional)
# ---------------------------------------------------------------------------
# Leave these blank for normal use. Agents sign in through the app panel and
# their credentials are sent per request, so the server holds none at rest.
#
# Set them only for unattended testing. Anything set here becomes the fallback
# for every caller of this backend, which is why it is not the default.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Recording links
# ---------------------------------------------------------------------------
# Recording links written into Zendesk tickets carry an encrypted token rather
# than your API credentials. This secret is the key for those tokens.
#
# Generate one with:  openssl rand -hex 32
#
# Without it a random key is generated at each boot, and links written before
# the last restart stop resolving.
RECORDING_TOKEN_SECRET=

# How long a recording link stays valid, in milliseconds. Default 30 days.
RECORDING_TOKEN_TTL_MS=

# ---------------------------------------------------------------------------
# Zendesk REST credentials (optional)
# ---------------------------------------------------------------------------
# Only needed if you want the backend to write call logs itself. Otherwise the
# app writes them through the agent's own Zendesk session, which is preferable:
# the log is attributed to the agent rather than to one shared API user.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
