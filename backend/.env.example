# ─── Vobiz account ───────────────────────────────────────────────────────────
# One account owns the SIP endpoint, the caller ID and the balance. They are not
# interchangeable: Vobiz rejects a `from` number the account does not own.
VOBIZ_AUTH_ID=MA_XXXXXXXXXX
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX

# ─── SIP endpoint the panel registers as ─────────────────────────────────────
# NOTE: POST /Endpoint/ REWRITES the username you submit — send "zendeskagent"
# and the stored username comes back as something like "zendeskagent1187694299".
# Read the stored `username` back from the API response and put THAT here.
VOBIZ_SIP_USER=
VOBIZ_SIP_PASSWORD=
VOBIZ_REGISTRAR=registrar.vobiz.ai

# ─── Public reachability ─────────────────────────────────────────────────────
# Vobiz must reach /answer, /dial-status and /recording-ready over public HTTPS.
# A dead answer URL produces the exact symptom people blame on registration:
# the customer answers, hears ringback, then "the agent could not be reached".
PUBLIC_BASE=https://your-tunnel-or-domain.example.com

PORT=8092

# ─── Recording link signing ──────────────────────────────────────────────────
# Recording playback URLs are HMAC-signed with a short expiry. Set this to a
# long random string in production; left blank, a new one is generated on every
# restart and previously-issued links stop working.
SIGNING_SECRET=
# Panel playback links (minted fresh each time the panel lists recordings).
RECORDING_URL_TTL_SECONDS=300
# Links written into ticket comments. Long enough for an agent to open the
# ticket days later; still signed and still expiring. Default 7 days.
TICKET_RECORDING_LINK_TTL_SECONDS=604800

# ─── Zendesk REST API (ticket write-back) ────────────────────────────────────
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=admin@yourcompany.com
ZENDESK_API_TOKEN=
# Leave the three above blank to have the panel write call logs through the
# agent's own Zendesk session instead (comments are then attributed to the agent).

# Optional: enables POST /transcription-ready for a transcription service, which
# must send "Authorization: Bearer <this value>". Blank = the route is off.
TRANSCRIPTION_WEBHOOK_SECRET=

# ─── Zendesk Marketplace request headers ─────────────────────────────────────
# Required on external API requests once the app is listed. Organization ID is
# on the Organization page at apps.zendesk.com; App ID appears on the app tile
# under Apps > Approved Apps after the app is accepted.
ZENDESK_MARKETPLACE_NAME=Vobiz Calling
ZENDESK_MARKETPLACE_ORG_ID=
ZENDESK_MARKETPLACE_APP_ID=

# Extra browser origins allowed to call this backend, comma separated.
# Allowed by default: *.apps.zdusercontent.com (where Zendesk serves the app's
# iframe), *.zendesk.com, *.zdassets.com and localhost.
ALLOWED_ORIGINS=
